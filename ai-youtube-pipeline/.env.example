# AI YouTube Pipeline Configuration Template
# Copy to .env and fill in your actual values

# Claude API Configuration
CLAUDE_API_KEY=sk-...

# Image Generation API (use IMAGE_PROVIDER=http for a provider-backed endpoint)
IMAGE_API_KEY=
IMAGE_PROVIDER=
IMAGE_API_URL=
IMAGE_TIMEOUT_SECONDS=30
IMAGE_MAX_RETRIES=2

# Voice Generation API (use VOICE_PROVIDER=http for a provider-backed endpoint)
VOICE_API_KEY=
VOICE_PROVIDER=
VOICE_API_URL=
VOICE_TIMEOUT_SECONDS=30
VOICE_MAX_RETRIES=2

# YouTube API Configuration (Phase 6)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8080/oauth2callback
YOUTUBE_TOKEN_FILE=data/youtube_token.json
YOUTUBE_CATEGORY_ID=22
YOUTUBE_PRIVACY_STATUS=private

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
DRY_RUN=true
STORAGE_BACKEND=sqlite

# Cost controls (zero disables a limit; usage values come from provider responses)
MONTHLY_BUDGET_USD=0
IMAGE_COST_PER_UNIT_USD=0
VOICE_COST_PER_UNIT_USD=0
IMAGE_QUOTA_UNITS=0
VOICE_QUOTA_UNITS=0

# File Paths
DATA_DIR=data
