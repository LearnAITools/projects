# AI YouTube Pipeline Configuration Template
# Copy to .env and fill in your actual values

# Claude API Configuration
CLAUDE_API_KEY=sk-...

# Image Generation API (to be specified in Phase 3)
IMAGE_API_KEY=
IMAGE_PROVIDER=

# Voice Generation API (to be specified in Phase 4)
VOICE_API_KEY=
VOICE_PROVIDER=

# YouTube API Configuration (Phase 6)
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=http://localhost:8080/oauth2callback
YOUTUBE_TOKEN_FILE=data/youtube_token.json
YOUTUBE_CATEGORY_ID=22
YOUTUBE_PRIVACY_STATUS=private

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
DRY_RUN=true

# File Paths
DATA_DIR=data
